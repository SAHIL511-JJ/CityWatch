# Copy to .env and fill in. Runtime uses POOLER URL; Alembic uses DIRECT URL.
SUPABASE_URL=https://xyzcompany.supabase.co
SUPABASE_SERVICE_KEY=eyJ...service_role...key
SUPABASE_DB_URL_POOLER=postgresql+psycopg2://postgres.xyz:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres
SUPABASE_DB_URL_DIRECT=postgresql+psycopg2://postgres:PASSWORD@db.xyz.supabase.co:5432/postgres
JWT_SECRET=change-me-to-32-random-chars
REDIS_URL=redis://localhost:6379/0
# Upstash example: REDIS_URL=rediss://default:PASSWORD@host:6379
FCM_CRED_JSON=
# Direct Google Gemini (free ~1500/day). Get one at https://aistudio.google.com -> Get API key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
AI_API_KEY=
STORAGE_BUCKET=incident-photos
